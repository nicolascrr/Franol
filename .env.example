# Password required to access the application (single shared password)
APP_PASSWORD=your_secure_password_here

# API key for AI-powered quiz generation and explanations
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase project URL (public — used in both client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (public — safe to expose, restricted by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
